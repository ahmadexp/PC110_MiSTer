From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ahmadexp <ahmadexp@gmail.com>
Date: Tue, 28 Jul 2026 23:32:39 -0700
Subject: [PATCH 2/4] x86: add an explicit PC110 machine profile

---
 support/x86/x86.cpp |  8 +++++++-
 user_io.cpp         | 27 +++++++++++++++++++++++----
 user_io.h           |  9 +++++++++
 3 files changed, 39 insertions(+), 5 deletions(-)

diff --git a/support/x86/x86.cpp b/support/x86/x86.cpp
index 85621ce..1463222 100644
--- a/support/x86/x86.cpp
+++ b/support/x86/x86.cpp
@@ -488,7 +488,13 @@ static void hdd_set(int num, char* filename)
 	}
 
 	if(!present && vhd) present = ide_img_mount(&ide_image[num], filename, 1);
-	if (!cd && is_pcxt())
+	if (!cd && x86_get_profile() == X86_PROFILE_PC110)
+	{
+		// The PC110 internal flash and PCMCIA ATA devices use the
+		// machine's native 2-head, 32-sector geometry.
+		ide_img_set(num, present ? &ide_image[num] : 0, cd, 32, 2);
+	}
+	else if (!cd && is_pcxt())
 	{
 		FILE* fd;
 		uint64_t size;
diff --git a/user_io.cpp b/user_io.cpp
index 5bb9fe6..df7f129 100644
--- a/user_io.cpp
+++ b/user_io.cpp
@@ -221,11 +221,29 @@ char is_menu()
 	return (is_menu_type == 1);
 }
 
-static int is_x86_type = 0;
+static x86_profile_t x86_profile = X86_PROFILE_NONE;
+static int x86_profile_valid = 0;
+
+x86_profile_t x86_get_profile()
+{
+	if (!x86_profile_valid)
+	{
+		if (!strcasecmp(orig_name, "AO486"))
+			x86_profile = X86_PROFILE_AO486;
+		else if (!strcasecmp(orig_name, "PC110"))
+			x86_profile = X86_PROFILE_PC110;
+		else
+			x86_profile = X86_PROFILE_NONE;
+
+		x86_profile_valid = 1;
+	}
+
+	return x86_profile;
+}
+
 char is_x86()
 {
-	if (!is_x86_type) is_x86_type = strcasecmp(orig_name, "AO486") ? 2 : 1;
-	return (is_x86_type == 1);
+	return x86_get_profile() != X86_PROFILE_NONE;
 }
 
 static int is_snes_type = 0;
@@ -420,7 +438,8 @@ char has_menu()
 void user_io_read_core_name()
 {
 	is_menu_type = 0;
-	is_x86_type  = 0;
+	x86_profile = X86_PROFILE_NONE;
+	x86_profile_valid = 0;
 	is_no_type   = 0;
 	is_snes_type = 0;
 	is_sgb_type = 0;
diff --git a/user_io.h b/user_io.h
index 648736f..1109e4d 100644
--- a/user_io.h
+++ b/user_io.h
@@ -272,6 +272,15 @@ void diskled_on();
 char is_minimig();
 char is_sharpmz();
 char is_menu();
+
+typedef enum
+{
+	X86_PROFILE_NONE,
+	X86_PROFILE_AO486,
+	X86_PROFILE_PC110
+} x86_profile_t;
+
+x86_profile_t x86_get_profile();
 char is_x86();
 char is_snes();
 char is_sgb();
