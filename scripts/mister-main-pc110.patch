--- a/ide.cpp
+++ b/ide.cpp
@@ -473,9 +473,16 @@ void ide_img_set(uint32_t drvnum, fileTYPE *f, int cd, int sectors, int heads, i
 	{
 		if (drive->present)
 		{
-			if (!drive->chd_f) 
+			if (!drive->chd_f)
 			{
-				if (parse_vhd_config(drive)) ide_set_geometry(drive, sectors, heads);
+				// Explicit geometry from the caller (e.g. the PC110 core's
+				// native 2 heads x 32 sectors) wins.  Without it a raw
+				// image with no VHD config falls to ide_set_geometry(0,0)
+				// which defaults to 16 heads x 256 sectors - and 256 SPT is
+				// an invalid ATA value that wraps to 0 in INIT DEVICE
+				// PARAMETERS, so the PC110 BIOS rejects the drive.
+				if (sectors && heads) ide_set_geometry(drive, sectors, heads);
+				else if (parse_vhd_config(drive)) ide_set_geometry(drive, sectors, heads);
 				else ide_set_geometry(drive, drive->spt, drive->heads);
 			}
 			else ide_set_geometry(drive, sectors, heads);
